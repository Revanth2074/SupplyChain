# ---------- Synapt (context substrate via MCP) ----------
# Synapt connection settings are intentionally omitted from this template.
# Configure SYNAPT_USERNAME, SYNAPT_PASSWORD, SYNAPT_PROVIDER_ID,
# SYNAPT_AUTH_BASE and SYNAPT_MCP_URL in your private backend/.env file.
SYNAPT_TOP_K=5
SYNAPT_GRAPH_HOPS=2

# ---------- Judge LLM (OpenAI-compatible; used ONLY for evaluation, never by the agents) ----------
# Preferred names (reference-capstone style). NVIDIA example shown; aicredits.in works the same way.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
# Older names, still accepted when the OPENAI_* names are not set:
LLM_BASE_URL=https://aicredits.in/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# ---------- Local data (fallback + ML) ----------
DATA_CSV=../supply_chain_disruption_recovery.csv
