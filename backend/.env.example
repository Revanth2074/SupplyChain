# ---------- Synapt (context substrate via MCP) ----------
SYNAPT_MCP_URL=https://beta.synapt.ai/tristore/mcp/
SYNAPT_AUTH_BASE=https://beta.synapt.ai/auth_service/api/v1/auth/token
SYNAPT_USERNAME=your_synapt_username_or_email
SYNAPT_PASSWORD=your_synapt_password
SYNAPT_PROVIDER_ID=supply_chain_disruptions
SYNAPT_TOP_K=5
SYNAPT_GRAPH_HOPS=2

# ---------- Judge LLM (OpenAI-compatible; used ONLY for evaluation, never by the agents) ----------
# Preferred names (reference-capstone style). NVIDIA example shown; aicredits.in works the same way.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
# Older names, still accepted when the OPENAI_* names are not set:
LLM_BASE_URL=https://aicredits.in/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# ---------- Local data (keyword + profile search, statistics, ML) ----------
DATA_CSV=../supply_chain_disruption_recovery.csv
