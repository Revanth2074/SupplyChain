{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "D:\\SupplyChain\\backend\\.venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--app-dir",
        "D:\\SupplyChain\\backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_PORT=8010&& npm --prefix D:/SupplyChain/frontend run dev -- --host 127.0.0.1 --port 3000"
      ],
      "port": 3000
    }
  ]
}